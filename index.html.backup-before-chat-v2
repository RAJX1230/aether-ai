<!DOCTYPE html>
<html lang="en">
<head>


<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AETHER AI</title>
<link rel="icon" type="image/svg+xml" href="logo.svg">
<link rel="stylesheet" href="style.css">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#faf9f7">
</head>
<body>

  <div class="app">

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="sidebar" id="sidebar">
      <div class="sidebar-top">
        <img src="logo.svg" alt="AETHER" class="brand-logo">
        <span class="brand">AETHER</span>
      </div>

      <div class="sidebar-header">
        <input type="text" id="searchChats" placeholder="Search chats...">
      </div>

      <div class="nav-links">
        <div class="nav-item" id="exportBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
          <span>Export Chat</span>
        </div>
        <div class="nav-item" id="settingsBtn" onclick="location.href='settings.html'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.6a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
          <span>Settings</span>
        </div>
        <div class="nav-item" onclick="window.location.href='voice.html'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg>
          <span>Voice Mode</span>
        </div>
        <div class="nav-item" onclick="window.location.href='lecture.html'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg>
          <span>Lecture Notes</span>
        </div>
        <div class="nav-item" onclick="window.location.href='group.html'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          <span>Group Study</span>
        </div>
        <div class="nav-item" onclick="window.location.href='about.html'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <span>About</span>
        </div>
      </div>

      <div class="section-label">Recents</div>
      <button class="new-chat-btn" id="newChatBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New Chat
      </button>
      <div class="chat-list" id="chatList"></div>

      <div class="sidebar-footer">
        <div class="user-avatar" id="userAvatar"></div>
        <span class="user-email" id="userEmailDisplay"></span>
        <button id="logoutBtn">Logout</button>
      </div>
    </div>

    <div class="settings-overlay" id="settingsOverlay"></div>
    <div class="settings-modal" id="settingsModal">
      <h3>Settings</h3>

      <label>Theme</label>
      <div class="theme-toggle">
        <button id="darkThemeBtn" class="theme-option">Dark</button>
        <button id="lightThemeBtn" class="theme-option active">Light</button>
      </div>

      <label>Font Size</label>
      <div class="font-toggle">
        <button class="font-option" data-size="small">Small</button>
        <button class="font-option active" data-size="medium">Medium</button>
        <button class="font-option" data-size="large">Large</button>
      </div>

      <label>AI Ka Naam</label>
      <input type="text" id="aiNameInput" placeholder="AETHER AI">

      <button id="clearAllBtn" class="danger-btn">Delete All Chats</button>

      <button id="closeSettingsBtn" class="save-btn">Save & Close</button>
    </div>

    <div class="attach-overlay" id="attachOverlay"></div>
    <div class="attach-menu" id="attachMenu">
      <div class="attach-option" id="cameraOption">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
        <span>Camera</span>
      </div>
      <div class="attach-option" id="galleryOption">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        <span>Photos</span>
      </div>
      <div class="attach-option" id="filesOption">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg>
        <span>Files</span>
      </div>
    </div>

    <div class="chat-container">
      <header class="chat-header">
        <button class="menu-btn" id="menuBtn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
        <img src="logo.svg" alt="AETHER" class="header-logo">
        <h1 id="appTitle">AETHER AI</h1>
      </header>

      <div class="chat-box" id="chatBox"></div>

      <div class="file-preview" id="filePreview"></div>

      <div class="input-area">
        <button id="attachBtn" title="Attach">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        </button>
        <input type="file" id="cameraInput" accept="image/*" capture="environment" hidden>
        <input type="file" id="galleryInput" accept="image/*" hidden>
        <input type="file" id="filesInput" accept="application/pdf,.txt,image/*" hidden>
        <button id="micBtn" title="Voice Input">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg>
        </button>
        <input type="text" id="userInput" placeholder="Message AETHER..." maxlength="1000">
        <button id="sendBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
      </div>
    </div>

  </div>

  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
  <script src="firebase-config.js"></script>
  <script src="export.js"></script>
  <script src="script.js"></script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('sw.js');
    }
  </script>
</body>
</html>
